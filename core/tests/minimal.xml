<!-- Minimal DD4hep geometry with only a world volume, for the GeoSvc tests -->
<lccdd>
  <info name="minimal" title="Minimal geometry for algorithms tests" author="algorithms" url="" status="test" version="1.0"/>
  <define>
    <constant name="world_side" value="1*m"/>
    <constant name="world_x" value="world_side"/>
    <constant name="world_y" value="world_side"/>
    <constant name="world_z" value="world_side"/>
  </define>
  <materials>
    <element Z="1" formula="H" name="H">
      <atom type="A" unit="g/mol" value="1.00794"/>
    </element>
    <material name="Air">
      <D type="density" unit="g/cm3" value="0.0012"/>
      <fraction n="1.0" ref="H"/>
    </material>
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="0.0000000001"/>
      <fraction n="1.0" ref="H"/>
    </material>
  </materials>
</lccdd>
