//
// Version of the algorithms library, generated by CMake from core/version.h.in
//
// Use the preprocessor macros for conditional compilation, e.g.
//
//   #include <algorithms/version.h>
//   #if ALGORITHMS_VERSION >= ALGORITHMS_VERSION_CODE(2, 1, 0)
//   ...
//   #endif
//
// and the constexpr variables and function in all other cases.
//
#pragma once

#include <string_view>

#define ALGORITHMS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ALGORITHMS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ALGORITHMS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ALGORITHMS_VERSION_STRING "@PROJECT_VERSION@"

// Encode a version as a single integer, ordered like the version (minor and
// patch must be below 1000)
#define ALGORITHMS_VERSION_CODE(major, minor, patch)                                               \
  ((major) * 1000000 + (minor) * 1000 + (patch))
#define ALGORITHMS_VERSION                                                                         \
  ALGORITHMS_VERSION_CODE(ALGORITHMS_VERSION_MAJOR, ALGORITHMS_VERSION_MINOR,                      \
                          ALGORITHMS_VERSION_PATCH)

namespace algorithms {

inline constexpr unsigned int versionMajor     = ALGORITHMS_VERSION_MAJOR;
inline constexpr unsigned int versionMinor     = ALGORITHMS_VERSION_MINOR;
inline constexpr unsigned int versionPatch     = ALGORITHMS_VERSION_PATCH;
inline constexpr std::string_view versionString = ALGORITHMS_VERSION_STRING;

// True if this version is at least major.minor.patch
constexpr bool versionAtLeast(unsigned int major, unsigned int minor = 0, unsigned int patch = 0) {
  if (versionMajor != major) {
    return versionMajor > major;
  }
  if (versionMinor != minor) {
    return versionMinor > minor;
  }
  return versionPatch >= patch;
}

} // namespace algorithms
